# OmniBid India & Affiliate Marketing Suite Environment Configuration

# 1. Supabase PostgreSQL Databases
# Transaction Pooler (Port 6543) - API runtime queries
DATABASE_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require
# Direct Connection (Port 5432) - Drizzle migrations
DIRECT_URL=postgresql://postgres.[ref]:[password]@aws-0-[region].pooler.supabase.com:5432/postgres?sslmode=require

# 2. Supabase Auth & Private Storage
SUPABASE_URL=https://[project-ref].supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOi...

# 3. Server Configuration
NODE_ENV=production
PORT=3001
SESSION_SECRET=super_secret_omnibid_india_2026_key
JWT_SECRET=super_secret_omnibid_india_2026_key
SOCKET_CORS_ORIGIN=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,https://omnibid-india.vercel.app

# 4. Razorpay INR Monetization & Escrow (Test & Live)
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_hmac_secret

# 5. Autonomous Affiliate Marketing Suite
FLASK_ENV=production
FLASK_SECRET_KEY=affiliate_secret_production_key_1234
SQLITE_DB_PATH=/var/data/affiliate.db
POSTBACK_SECRET=default_secret_key_123
OMNIBID_AFFILIATE_BASE_URL=https://prompt-understander-1.onrender.com/api/affiliate/r
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# 6. AI Smart Match Engine
GEMINI_API_KEY=your_gemini_api_key

# 7. WhatsApp Business API (Optional)
WHATSAPP_VERIFY_TOKEN=your-verify-token
WHATSAPP_ACCESS_TOKEN=your-access-token
WHATSAPP_PHONE_NUMBER_ID=your-phone-id
