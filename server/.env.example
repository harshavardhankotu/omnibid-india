# OmniBid Server Environment Configuration
PORT=3001
NODE_ENV=development

# Database (Supabase PostgreSQL Connection Pooler)
# API Runtime (Transaction pooler - port 6543)
DATABASE_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres
# Migrations & Drizzle-Kit (Direct Session mode - port 5432)
DIRECT_URL=postgresql://postgres:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres

# Supabase Auth & Realtime
SUPABASE_URL=https://[PROJECT-REF].supabase.co
SUPABASE_ANON_KEY=[YOUR-SUPABASE-ANON-KEY]
SUPABASE_SERVICE_ROLE_KEY=[YOUR-SUPABASE-SERVICE-ROLE-KEY]

# Security & CORS
SESSION_SECRET=super_secret_session_key_min_32_chars
SOCKET_CORS_ORIGIN=http://localhost:3000
APP_BASE_URL=http://localhost:3000

# Payments & Escrow (Razorpay)
RAZORPAY_KEY_ID=rzp_test_[KEY_ID]
RAZORPAY_KEY_SECRET=[KEY_SECRET]
RAZORPAY_ACCOUNT_NUMBER=acc_[MERCHANT_ACCOUNT_ID]
RAZORPAY_WEBHOOK_SECRET=[WEBHOOK_SECRET_MIN_32_CHARS]

# AI Engines
GEMINI_API_KEY=[YOUR-GOOGLE-GEMINI-API-KEY]
