{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "scripts": {
    "build": "npx --yes pnpm --filter @omnibid/client run build && npx --yes pnpm --filter @omnibid/server run build",
    "start": "node server/dist/index.mjs",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "vitest run",
    "dev:client": "pnpm --filter @omnibid/client run dev",
    "dev:server": "pnpm --filter @omnibid/server run dev",
    "dev": "pnpm run dev:server & pnpm run dev:client"
  },
  "private": true,
  "devDependencies": {
    "typescript": "~5.9.2",
    "prettier": "^3.8.1",
    "zod": "^3.24.1",
    "@supabase/supabase-js": "^2.49.1",
    "drizzle-orm": "^0.45.2",
    "pg": "^8.11.3",
    "@types/pg": "^8.11.2",
    "vitest": "^5.0.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "bcrypt"
    ]
  }
}
